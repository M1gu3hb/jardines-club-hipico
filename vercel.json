{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "images": {
    "sizes": [
      256,
      384,
      512,
      640,
      768,
      1024,
      1280,
      1600,
      1920,
      2560
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "qualities": [
      50,
      72,
      90,
      95
    ],
    "minimumCacheTTL": 31536000,
    "localPatterns": [
      {
        "pathname": "^/media/.*$",
        "search": ""
      }
    ],
    "dangerouslyAllowSVG": false
  },
  "redirects": [
    {
      "source": "/portal",
      "destination": "https://jch-portal-cliente.vercel.app/",
      "statusCode": 301
    },
    {
      "source": "/portal/",
      "destination": "https://jch-portal-cliente.vercel.app/",
      "statusCode": 301
    },
    {
      "source": "/invitacion/:token",
      "destination": "https://jch-portal-cliente.vercel.app/invitacion/:token",
      "statusCode": 301
    },
    {
      "source": "/ubicacion",
      "destination": "/contacto",
      "statusCode": 301
    },
    {
      "source": "/ubicacion/",
      "destination": "/contacto",
      "statusCode": 301
    },
    {
      "source": "/nosotros",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/nosotros/",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(self), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://vuzyhbiwnnngeohysxcw.supabase.co; media-src 'self' blob: https://vuzyhbiwnnngeohysxcw.supabase.co; connect-src 'self' https://vuzyhbiwnnngeohysxcw.supabase.co wss://vuzyhbiwnnngeohysxcw.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
